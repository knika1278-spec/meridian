  "memory": {
    "enabled": true,
    "journalFile": "./data/decision-journal.jsonl",
    "injectIntoScreener": true,
    "injectIntoManager": false,
    "injectIntoPostMortem": true,
    "recentLimit": 8,
    "maxPromptItems": 6,
    "includeLearningEvidence": true,
    "minEvidenceForPrompt": 5
